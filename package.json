{
  "name": "varbase_seo",
  "description": "Provide Search Engine Optimization (SEO) Core features and settings.",
  "license": "GPL-2.0-or-later",
  "private": true,
  "engines": {
    "yarn": ">= 4.18.1",
    "node": ">= 24.0"
  },
  "keywords": [
    "Drupal",
    "Varbase",
    "Varbase SEO",
    "SEO",
    "Search Engine Optimization"
  ],
  "author": "Vardot",
  "scripts": {
    "phpcs": "phpcs --standard=./.phpcs.xml .",
    "phpcbf": "phpcbf --standard=./.phpcs.xml .",
    "lint:js": "eslint --ext .js .",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:yaml": "eslint --ext .yml .",
    "spellcheck": "cspell lint .",
    "test": "node ./node_modules/@cucumber/cucumber/bin/cucumber.js --config cucumber.js",
    "test:chromium": "BROWSER=chromium node ./node_modules/@cucumber/cucumber/bin/cucumber.js --config cucumber.js",
    "test:firefox": "BROWSER=firefox node ./node_modules/@cucumber/cucumber/bin/cucumber.js --config cucumber.js",
    "test:webkit": "BROWSER=webkit node ./node_modules/@cucumber/cucumber/bin/cucumber.js --config cucumber.js",
    "generate-reports": "node ./node_modules/@vardot/varbase-e2e/bin/generate-reports.js"
  },
  "dependencies": {
    "@vardot/varbase-e2e": "^2.0.8"
  },
  "devDependencies": {
    "cspell": "^8.16.1",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jquery": "^1.5.1",
    "eslint-plugin-prettier": "^5.4.0",
    "eslint-plugin-yml": "^1.18.0",
    "prettier": "^3.5.3",
    "stylelint": "^16.12.0"
  },
  "browserslist": [
    "last 2 Chrome major versions",
    "last 2 Firefox major versions",
    "last 2 Safari major versions",
    "last 2 Edge major versions",
    "last 2 Opera versions",
    "last 2 iOS major versions",
    "last 1 ChromeAndroid version",
    "last 1 Samsung version",
    "Firefox ESR"
  ],
  "packageManager": "yarn@4.18.1"
}
