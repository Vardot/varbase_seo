<?php

/**
 * @file
 * Contains varbase_seo.module.
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\varbase_seo\Hook\VarbaseSeoHooks;

/**
 * Implements hook_form_BASE_FORM_ID_alter().
 */
#[LegacyHook]
function varbase_seo_form_node_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  \Drupal::service(VarbaseSeoHooks::class)->formNodeFormAlter($form, $form_state, $form_id);
}

/**
 * Implements hook_form_BASE_FORM_ID_alter().
 */
#[LegacyHook]
function varbase_seo_form_metatag_defaults_edit_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  \Drupal::service(VarbaseSeoHooks::class)->formMetatagDefaultsEditFormAlter($form, $form_state, $form_id);
}

/**
 * Implements hook_modules_installed().
 */
#[LegacyHook]
function varbase_seo_modules_installed($modules) {
  \Drupal::service(VarbaseSeoHooks::class)->modulesInstalled($modules);
}

/**
 * Implements hook_pathauto_punctuation_chars_alter().
 */
#[LegacyHook]
function varbase_seo_pathauto_punctuation_chars_alter(array &$punctuation) {
  \Drupal::service(VarbaseSeoHooks::class)->pathautoPunctuationCharsAlter($punctuation);
}
